# ===========================================
# AI Novel Workstation - 环境变量配置模板
# ===========================================
#
# 说明：实际配置不放在本文件。运行时会写入「用户配置目录」：
#   Windows: %APPDATA%\AI-Novel-Workstation\.env
#   其他:    ~/.config/AI-Novel-Workstation/.env
# 首次运行若在程序根目录发现旧的 .env，会自动迁移过去。
# 可用环境变量 AI_NOVEL_CONFIG_DIR 覆盖配置目录（便携/测试用）。
#
# 以下为各配置项的含义说明，不需要复制本文件。

# --- 模型池配置（自动生成，请勿手动编辑） ---
# 通过前端"模型配置"页面管理，配置自动保存到用户配置目录
# MODEL_POOL=[{"id":"...","name":"...","api_key":"...","base_url":"...","model":"...",...}]
# MODEL_ASSIGNMENTS={"text":"model_id","structure":"model_id","check":"model_id"}

# --- 项目目录配置 ---
# 用户产物（小说项目数据）的存储目录
# 默认：%USERPROFILE%\Documents\AI-Novels （未设置时）
# 相对路径基于程序根目录解析，也可使用绝对路径
# PROJECT_DIR=D:\Novels\AI-novel-project

# --- 多轮对话上下文管理 ---
# 模型上下文窗口（token），用于控制发送给 LLM 的历史消息总量
# MODEL_CONTEXT_WINDOW=32768
# 为模型回复预留的输出 token（避免提示词过长导致无法作答）
# MODEL_RESERVED_OUTPUT_TOKENS=2048

# --- 联网搜索配置 ---
# 搜索源优先级（逗号分隔），可选：tavily,serper,bing,cn_bing,ddg
# 未配置 Key 的 API 源（tavily/serper）会自动跳过；无 Key 时回退到 bing 免费抓取
# WEB_SEARCH_PROVIDERS=tavily,serper,bing,cn_bing,ddg
# Tavily 搜索 API Key（https://tavily.com）
# TAVILY_API_KEY=
# Serper 搜索 API Key（https://serper.dev）
# SERPER_API_KEY=

# --- 通用配置 ---
LOG_LEVEL=INFO
DEFAULT_TEMPERATURE=0.7
DEFAULT_TIMEOUT=120
DEFAULT_MAX_RETRIES=3
